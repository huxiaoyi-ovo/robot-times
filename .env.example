# 本地版的可选配置。复制到 ~/.robot-times/.env（或仓库根目录的 .env）后修改，不会提交到 git。
# 研究兴趣、arXiv 分类等在 robot-times local init 或看板的“设置”里改，不在这里。

# 大模型（可选，强烈建议）：有了它才有精排、中文摘要和全文解读、“问 AI”
DEEPSEEK_API_KEY=

# 换成其他 OpenAI 兼容的模型时填这三项（例如本地 Ollama：http://localhost:11434/v1）
ROBOT_TIMES_LLM_BASE_URL=
ROBOT_TIMES_LLM_API_KEY=
ROBOT_TIMES_LLM_MODEL=

# 本地向量模型（需要 uv sync --extra embed）
ROBOT_TIMES_EMBED_MODEL=BAAI/bge-small-en-v1.5

# 加入 Zotero 时是否下载 arXiv 的 PDF 存进 Zotero（默认 1，填 0 关掉）
ROBOT_TIMES_ZOTERO_PDF=1
